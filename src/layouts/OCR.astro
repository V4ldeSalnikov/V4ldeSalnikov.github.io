---
import '../styles/ocr-leaderboard.css';
interface Props { title: string; description: string; active: 'leaderboard' | 'compare' | 'datasets' | 'methodology' }
const { title, description, active } = Astro.props;
const links = [['leaderboard', 'Leaderboard', '/ocr-eval/'], ['compare', 'Compare', '/ocr-eval/compare/'], ['datasets', 'Datasets', '/ocr-eval/datasets/'], ['methodology', 'Methodology', '/ocr-eval/methodology/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <title>{title} · ScandiOCR Eval</title>
    <link rel="icon" type="image/svg+xml" href="/ocr-eval/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="header-inner">
      <a class="wordmark" href="/ocr-eval/" aria-label="ScandiOCR Eval home">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M10 3H3v7m19-7h7v7M3 22v7h7m19-7v7h-7M10 12h12m-12 5h12m-12 5h7" stroke="currentColor" stroke-width="2.5" /></svg>
        <span>ScandiOCR <b>Eval</b></span>
      </a>
      <nav aria-label="Main navigation">{links.map(([id, label, href]) => <a href={href} aria-current={active === id ? 'page' : undefined}>{label}</a>)}</nav>
      <a class="source-link" href="https://github.com/V4ldeSalnikov/OCR-eval">GitHub <span aria-hidden="true">↗</span></a>
    </div></header>
    <main id="main" class="site-main"><slot /></main>
    <footer class="site-footer"><span>ScandiOCR Eval</span><div><a href="/ocr-eval/results.json" download>Download results</a><a href="https://github.com/V4ldeSalnikov/OCR-eval">Source code ↗</a></div></footer>
  </body>
</html>
