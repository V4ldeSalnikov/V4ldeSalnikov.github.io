---
import OCR from '../../layouts/OCR.astro';
import snapshot from '../../../public/ocr-eval/results.json';
import { datasetDescriptions, languageNames } from '../../data/ocr-datasets';
const datasets = snapshot.datasets.map(item => ({ ...item, ...datasetDescriptions[item.id], samples: snapshot.sample_sets.filter(sample => sample.dataset_id === item.id) }))
  .sort((a, b) => a.language_codes[0].localeCompare(b.language_codes[0]) || a.name.localeCompare(b.name));
const numbers = new Intl.NumberFormat('en-GB');
---
<OCR title="Datasets" description="The documents, languages, transcriptions and evaluation samples used in ScandiOCR Eval." active="datasets">
  <header class="page-heading"><div><h1>Datasets</h1><p>What the models read, and where the reference text comes from.</p></div><p class="benchmark-size">{datasets.length} datasets <span>·</span> {Object.keys(languageNames).length} languages</p></header>
  <div class="documentation-layout">
    <nav class="contents" aria-label="Datasets on this page">
      {Object.entries(languageNames).map(([code, name]) => <div><h2>{name}</h2>{datasets.filter(item => item.language_codes.includes(code)).map(item => <a href={`#${item.id}`}>{item.name}</a>)}</div>)}
    </nav>
    <div class="dataset-list">
      <p class="document-intro">Sample counts below describe this benchmark, not the full source collections. The same selected images and references are used for every model.</p>
      {datasets.map(item => <article id={item.id} class="dataset-entry">
        <div class="entry-meta">{item.language_codes.map(code => languageNames[code]).join(' / ')} <span>·</span> {item.id === 'danish-typewritten' ? 'Typewritten' : item.document_type === 'handwritten' ? 'Handwritten' : 'Printed'}</div>
        <h2>{item.name}</h2>
        <p>{item.description}</p>
        <p><strong>Reference text.</strong> {item.reference}</p>
        <div class="sample-summary">{item.samples.map(sample => <div><a href={`/ocr-eval/?task=${sample.task}&dataset=${item.id}`}>{numbers.format(sample.selected_samples)} {sample.task === 'line-recognition' ? 'lines' : 'pages'} <span aria-hidden="true">↗</span></a><span>{sample.split} split</span></div>)}</div>
        {item.note && <p class="dataset-note">{item.note}</p>}
        <div class="entry-links"><a href={item.source_url}>Source dataset ↗</a>{item.id.startsWith('oj4ocrmt') && <a href="https://aclanthology.org/2025.mtsummit-1.9/">Publication ↗</a>}</div>
      </article>)}
    </div>
  </div>
</OCR>
