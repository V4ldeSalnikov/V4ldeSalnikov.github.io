---
import OCR from '../../layouts/OCR.astro';
import snapshot from '../../../public/ocr-eval/results.json';
---
<OCR title="Leaderboard" description="Compare OCR models on Danish, Norwegian and Swedish handwriting and printed text." active="leaderboard">
  <header class="page-heading">
    <div><h1>Leaderboard</h1><p>OCR for Danish, Norwegian and Swedish.</p></div>
    <p class="benchmark-size">{snapshot.models.length} models <span>·</span> {snapshot.datasets.length} datasets</p>
  </header>
  <div class="benchmark-layout">
    <aside class="filters" aria-label="Filter results">
      <fieldset><legend>Language</legend>
        <div class="language-options">
          <button type="button" data-language="all" aria-pressed="true">All languages</button>
          <button type="button" data-language="da" aria-pressed="false"><span class="language-code">DA</span>Danish</button>
          <button type="button" data-language="no" aria-pressed="false"><span class="language-code">NO</span>Norwegian</button>
          <button type="button" data-language="sv" aria-pressed="false"><span class="language-code">SV</span>Swedish</button>
        </div>
      </fieldset>
      <div class="filter-select"><label for="document-type">Document type</label><select id="document-type"><option value="all">All documents</option><option value="handwritten">Handwritten</option><option value="printed">Printed / typed</option></select></div>
      <div class="filter-select"><label for="dataset">Dataset</label><select id="dataset"><option value="all">All datasets</option></select></div>
      <button type="button" id="reset-filters" class="text-button">Reset filters</button>
      <a class="dataset-guide" href="/ocr-eval/datasets/">About the datasets <span aria-hidden="true">↗</span></a>
    </aside>
    <section class="leaderboard" aria-label="Model scores">
      <div class="table-toolbar">
        <div class="task-options" role="group" aria-label="Recognition task"><button type="button" data-task="line-recognition" aria-pressed="true">Line recognition</button><button type="button" data-task="page-transcription" aria-pressed="false">Page transcription</button></div>
        <label class="search-control"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5"/></svg><span class="sr-only">Search models</span><input type="search" id="model-search" placeholder="Search models" /></label>
      </div>
      <div class="selection-bar"><span id="selection-description">Loading results…</span><a href="/ocr-eval/methodology/#metrics">How scores work ↗</a></div>
      <div id="load-error" class="message" role="alert" hidden></div>
      <div class="table-scroll" tabindex="0" aria-label="OCR results table">
        <table class="scores-table">
          <caption class="sr-only">Model rankings by error rate. Lower is better. Click CER or WER to rank by that metric.</caption>
          <thead><tr><th scope="col" class="rank-cell">#</th><th scope="col">Model</th><th scope="col" class="number-cell" id="cer-heading" aria-sort="ascending"><button type="button" data-metric="cer" aria-label="Rank by character error rate">CER <span data-sort-arrow aria-hidden="true">↓</span><small>Character error</small></button></th><th scope="col" class="number-cell" id="wer-heading"><button type="button" data-metric="wer" aria-label="Rank by word error rate">WER <span data-sort-arrow aria-hidden="true">↕</span><small>Word error</small></button></th></tr></thead>
          <tbody id="results-body"></tbody>
        </table>
      </div>
      <p id="table-status" class="message" role="status" aria-live="polite">Loading model scores…</p>
      <div class="table-footer"><span id="visible-models" aria-live="polite"></span><span>Error rates in % · lower is better</span></div>
      <div class="compare-tray" id="compare-tray" hidden><span id="compare-selection-count" aria-live="polite"></span><button type="button" id="clear-comparison" class="text-button">Clear</button><a id="compare-selected" href="/ocr-eval/compare/">Compare models →</a></div>
    </section>
  </div>
  <noscript><p class="message">Enable JavaScript to filter scores, or <a href="/ocr-eval/results.json">download the results</a>. The <a href="/ocr-eval/datasets/">datasets</a> and <a href="/ocr-eval/methodology/">methodology</a> pages work without JavaScript.</p></noscript>
  <script>import '../../scripts/ocr-leaderboard';</script>
</OCR>
