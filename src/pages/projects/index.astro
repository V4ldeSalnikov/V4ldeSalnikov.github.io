---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Projects">
  <section class="max-w-3xl mx-auto px-6 py-12">
    <h1 style="font-family: var(--font-serif); font-size: 2rem; margin: 0 0 0.4rem;">Projects</h1>
    <p style="color: var(--color-fg-dim); margin-bottom: 2.5rem;">
      University coursework, graphics experiments, side things.
    </p>
    {projects.length === 0 ? (
      <p style="color: var(--color-fg-dim); font-style: italic;">Nothing here yet.</p>
    ) : (
      projects.map((p) => (
        <PostCard
          href={`/projects/${p.id}/`}
          title={p.data.title}
          description={p.data.description}
          pubDate={p.data.pubDate}
          tags={p.data.tags}
        />
      ))
    )}
  </section>
</Base>
